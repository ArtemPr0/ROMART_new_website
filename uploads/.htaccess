# Deny public access to lead logs and mail secrets
<FilesMatch "^(leads\.jsonl|mail-config\.php)$">
  Require all denied
</FilesMatch>
# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  <FilesMatch "^(leads\.jsonl|mail-config\.php)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Remove diagnostic probes if still present
<FilesMatch "^mail-(probe|relay-probe|relay-probe2)\.php$">
  Require all denied
</FilesMatch>
